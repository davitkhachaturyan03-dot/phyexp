# The owner's cluster (chem, user gor) as a site profile for slurm/site.env. These are the values that were hardcoded in
# slurm/env.sh, slurm/gpu.sbatch and slurm/cpu.sbatch before training-attribution S6 (partition a100, /raid scratch,
# the FFmpeg libraries of the old vla-curation environment). On that cluster:
#     cp docs/site-profile-cluster.env slurm/site.env
PHYEXP_DIR=/auto/home/gor/projects/phyexp
SCRATCH_ROOT=/raid/chem/gor/phyexp
PARTITION=a100
LOG_DIR=${SCRATCH_ROOT}/logs
FFMPEG_LIB=/raid/chem/gor/vla-curation/envs/ffmpeg/lib
