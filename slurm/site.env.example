# Per-machine site configuration for the SLURM chain. Copy to slurm/site.env (gitignored) and edit:
#     cp slurm/site.env.example slurm/site.env
# `slurm/env.sh` sources it for every job; `scripts/server_pipeline.py` reads PARTITION and LOG_DIR from it (#SBATCH lines
# cannot expand variables, so the pipeline passes --partition/--output on the sbatch command line).
# The owner's own cluster values are kept, documented, in docs/site-profile-cluster.env (copy that file instead on that cluster).
# Plain KEY=VALUE lines; ${OTHER_KEY} expands to a key defined above it. No other shell syntax.

# Where the repository is checked out on the compute nodes (default: derived from the location of slurm/env.sh).
# PHYEXP_DIR=/path/to/repo

# A fast, large disk for the Arrow cache (about 7 GB per distinct training subset), TMPDIR and logs. REQUIRED.
SCRATCH_ROOT=/path/to/scratch/phyexp

# SLURM partition for every job, and the directory the job logs go to (created by env.sh).
PARTITION=gpu
# LOG_DIR must be on a filesystem the compute nodes share (the login node creates it before submitting; the jobs write to it).
LOG_DIR=${SCRATCH_ROOT}/logs

# Optional: directory with FFmpeg shared libraries for torchcodec (appended to LD_LIBRARY_PATH). Leave empty if the
# system has them.
FFMPEG_LIB=
